---
import { site } from '../../../shared/config/site';
import type { Locale } from '../../../shared/i18n/locales';
import { useContactUi } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = useContactUi(locale);
---

<aside class="rail" aria-label={strings.railLabel}>
  <a
    class="rail-btn"
    href={site.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${strings.linkedin} ${strings.opensInNewTab}`}
  >
    <span class="rail-text" aria-hidden="true">{strings.linkedin} ↗</span>
    <span class="rail-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><rect x="3" y="3" width="18" height="18"></rect><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"></path></svg
      >
    </span>
  </a>
  <a
    class="rail-btn"
    href={site.github}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${strings.github} ${strings.opensInNewTab}`}
  >
    <span class="rail-text" aria-hidden="true">{strings.github} ↗</span>
    <span class="rail-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><path
          d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5a3 3 0 0 0-.8-2.3c2.7-.3 5.5-1.3 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.5 2.6 5.5 2.9 5.5 2.9a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.3c0 4.6 2.8 5.6 5.5 6a3 3 0 0 0-.8 2.2V21"
        ></path></svg
      >
    </span>
  </a>
  <a class="rail-btn solid" href={site.cvPath} download aria-label={strings.cv}>
    <span class="rail-text" aria-hidden="true">{strings.cv} ↓</span>
    <span class="rail-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><path d="M14 3H6v18h12V7z"></path><path d="M14 3v4h4M12 11v6M9 14l3 3 3-3"></path></svg
      >
    </span>
  </a>
</aside>

<style>
  .rail {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .rail-btn {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 48px;
    margin-top: -1px;
    border: 1px solid var(--ink);
    border-right: 0;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    transition:
      background-color 0.3s ease 0.05s,
      color 0.3s ease 0.05s;
  }
  .rail-btn.solid {
    background: var(--ink);
    color: var(--paper);
  }
  .rail-btn:hover {
    opacity: 1;
  }
  .rail-btn:not(.solid):is(:hover, :focus-visible) {
    background: var(--ink);
    color: var(--paper);
  }
  .rail-btn:focus-visible {
    outline-offset: -4px;
  }
  .rail-icon {
    flex: 0 0 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rail-text {
    max-width: 0;
    opacity: 0;
    padding-left: 0;
    white-space: nowrap;
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition:
      max-width 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.15s ease,
      padding-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .rail-btn:is(:hover, :focus-visible) .rail-text {
    max-width: 200px;
    opacity: 1;
    padding-left: 16px;
    transition:
      max-width 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.12s,
      opacity 0.35s ease 0.3s,
      padding-left 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.12s;
  }
  @media (max-width: 640px) {
    .rail {
      top: auto;
      bottom: 16px;
      right: 16px;
      transform: none;
      flex-direction: row;
    }
    .rail-btn {
      margin-top: 0;
      margin-left: -1px;
      border-right: 1px solid var(--ink);
    }
    .rail-text {
      display: none;
    }
    /* Keep the footer readable above the fixed row. */
    :global(body) {
      padding-bottom: 80px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail-btn,
    .rail-text {
      transition: none !important;
    }
  }
</style>
