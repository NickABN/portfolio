---
import { site } from '../../../shared/config/site';
import type { Locale } from '../../../shared/i18n/locales';
import { useContactUi } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = useContactUi(locale);
const external = [
  { label: strings.linkedin, href: site.linkedin },
  { label: strings.github, href: site.github },
];
---

<section id="correspondence" class="contact" aria-labelledby="contact-title">
  <div class="slide message">
    <span class="kicker accent">{strings.kicker}</span>
    <h2 id="contact-title">
      {strings.headlineFirst}<br /><em>{strings.headlineEmphasis}</em>
    </h2>
    <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
  <ul class="fade links">
    {
      external.map(({ label, href }) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer">
            <span class="label">
              {label}
              <span class="sr-only"> {strings.opensInNewTab}</span>
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
    <li class="last">
      <a href={site.cvPath} download>
        <span class="label">{strings.cv}</span>
        <span aria-hidden="true">↓</span>
      </a>
    </li>
  </ul>
</section>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-end;
    padding: var(--space-6) 0;
  }
  .message {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .accent {
    color: var(--accent);
  }
  h2 {
    font-size: clamp(48px, 8vw, 112px);
    line-height: 0.95;
    font-weight: 400;
    letter-spacing: -0.035em;
  }
  h2 em {
    color: var(--display);
  }
  .email {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: clamp(22px, 2.6vw, 32px);
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }
  .links {
    flex: 1 1 280px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule);
  }
  li {
    border-bottom: var(--rule-hair);
  }
  li.last {
    border-bottom: var(--rule);
  }
  li a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 56px;
    text-decoration: none;
  }
</style>
