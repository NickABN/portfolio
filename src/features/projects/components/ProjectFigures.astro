---
import type { ImageMetadata } from 'astro';
import type { Locale } from '../../../shared/i18n/locales';
import { figureSectionNumbers, groupFigures, type FigureKind } from '../domain/figures';
import { useProjectsUi } from '../i18n';
import ProjectFigure from './ProjectFigure.astro';

interface FigureData {
  src: ImageMetadata;
  alt: string;
  caption: string;
  kind: FigureKind;
}

interface Props {
  locale: Locale;
  figures?: FigureData[];
  /** How many numbered `##` sections the Markdown body already has; these sections continue the count. */
  sectionsBefore: number;
}

const { locale, figures, sectionsBefore } = Astro.props;
const strings = useProjectsUi(locale);
const { diagrams, plates } = groupFigures(figures);
const pad = (n: number) => String(n).padStart(2, '0');
const sections = figureSectionNumbers(sectionsBefore, { diagrams, plates });
---

{
  diagrams.length > 0 && (
    <section class="wide" aria-labelledby="how-it-works">
      <h2 id="how-it-works">
        <span class="num">{pad(sections.howItWorks ?? 0)}</span>
        {strings.howItWorks}
      </h2>
      <div class="stack">
        {diagrams.map(({ figure, number }) => (
          <ProjectFigure
            natural
            fit="contain"
            zoomLabel={strings.openLarger}
            figLabel={`${strings.fig} ${number}`}
            caption={figure.caption}
            placeholder={strings.shot}
            cover={figure.src}
            coverAlt={figure.alt}
            sizes="(min-width: 1280px) 1168px, 100vw"
          />
        ))}
      </div>
    </section>
  )
}
{
  plates.length > 0 && (
    <section class="wide" aria-labelledby="plates">
      <h2 id="plates">
        <span class="num">{pad(sections.plates ?? 0)}</span>
        {strings.plates}
      </h2>
      <div class:list={['grid', { single: plates.length === 1 && plates[0].figure.kind !== 'screen' }]}>
        {plates.map(({ figure, number }) => (
          // Screenshots carry dense UI, so they take the full width; phone composites pair up.
          <div class:list={['plate', { full: figure.kind === 'screen' }]}>
            <ProjectFigure
              natural
              fit="contain"
              frame={figure.kind === 'screen'}
              zoomLabel={strings.openLarger}
              figLabel={`${strings.fig} ${number}`}
              caption={figure.caption}
              placeholder={strings.shot}
              cover={figure.src}
              coverAlt={figure.alt}
              sizes={figure.kind === 'screen' ? '(min-width: 1280px) 1168px, 100vw' : '(min-width: 960px) 570px, 100vw'}
            />
          </div>
        ))}
      </div>
    </section>
  )
}

{
  (diagrams.length > 0 || plates.length > 0) && (
    <dialog class="lightbox" aria-label={strings.openLarger}>
      <form method="dialog">
        <button class="close label" aria-label={strings.closeViewer}>
          {strings.closeViewer} ✕
        </button>
      </form>
      <img alt="" />
      <p class="cap"></p>
    </dialog>
  )
}

<script>
  // Progressive enhancement: without JS the figures are plain links to the large image.
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  if (dialog) {
    const img = dialog.querySelector('img');
    const cap = dialog.querySelector('.cap');
    let trigger: HTMLElement | null = null;
    document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const thumb = link.querySelector('img');
        if (!img || !cap) return;
        img.src = link.href;
        img.alt = thumb?.alt ?? '';
        cap.textContent = link.dataset.caption ?? '';
        trigger = link;
        dialog.showModal();
      });
    });
    // Only a click outside the dialog box closes it: clicks on its padding or on the empty space
    // beside a narrow image also target the dialog element, so compare against its bounds.
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const box = dialog.getBoundingClientRect();
      const inside =
        event.clientX >= box.left &&
        event.clientX <= box.right &&
        event.clientY >= box.top &&
        event.clientY <= box.bottom;
      if (!inside) dialog.close();
    });
    dialog.addEventListener('close', () => {
      trigger?.focus();
    });
  }
</script>

<style>
  .wide {
    margin-top: 72px;
  }
  h2 {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin: 0 0 24px;
    padding-top: 16px;
    border-top: var(--rule);
    font-size: 36px;
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 32px;
    align-items: start;
  }
  .grid.single {
    grid-template-columns: minmax(0, 720px);
  }
  .plate {
    min-width: 0;
  }
  .plate.full {
    grid-column: 1 / -1;
  }

  .lightbox {
    max-width: min(96vw, 1800px);
    max-height: 96vh;
    padding: 16px;
    border: var(--rule);
    background: var(--paper);
    color: var(--ink);
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.72);
  }
  .lightbox img {
    display: block;
    max-width: 100%;
    max-height: calc(96vh - 130px);
    margin: 0 auto;
  }
  .close {
    display: block;
    margin: 0 0 12px auto;
    min-height: var(--tap);
    padding: 0 14px;
    border: var(--rule);
    background: transparent;
    cursor: pointer;
  }
  .close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .cap {
    margin: 12px 0 0;
    font-size: var(--text-small);
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .wide {
      order: 1;
      margin-top: 56px;
    }
    h2 {
      font-size: 32px;
    }
  }
  @media (max-width: 640px) {
    /* Diagrams run edge to edge with a 16px gutter instead of the page's 22px. */
    .wide {
      margin-inline: calc(16px - var(--gutter));
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
