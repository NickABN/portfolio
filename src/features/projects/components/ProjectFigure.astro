---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  figLabel: string;
  caption?: string;
  placeholder: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  /** `contain` never crops the image (diagrams); `cover` fills the plate (screenshots). */
  fit?: 'cover' | 'contain';
  /** Wide editorial crop for the detail page: 21:9 on desktop, 16:10 on tablets and phones. */
  hero?: boolean;
}

const { figLabel, caption, placeholder, cover, coverAlt = '', fit = 'cover', hero = false } = Astro.props;
const sizes = hero ? '(min-width: 1280px) 1168px, 100vw' : '(min-width: 960px) 600px, 100vw';
// SVG is served as-is, so responsive widths only apply to raster covers.
const isSvg = cover?.format === 'svg';
const widths = hero ? [800, 1200, 1600, 2000] : [480, 800, 1200];
---

<figure class:list={{ hero }}>
  {
    cover ? (
      <Image
        class:list={['plate', { contain: fit === 'contain' }]}
        src={cover}
        alt={coverAlt}
        widths={isSvg ? undefined : widths}
        sizes={isSvg ? undefined : sizes}
      />
    ) : (
      <div class="plate mono" role="img" aria-label={placeholder}>
        {placeholder}
      </div>
    )
  }
  {
    caption && (
      <figcaption>
        <span class="label">{figLabel}</span> — {caption}
      </figcaption>
    )
  }
</figure>

<style>
  figure {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .plate {
    width: 100%;
    /* The <img> carries intrinsic height attributes that would otherwise beat aspect-ratio. */
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--plate);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
  }
  .plate.contain {
    object-fit: contain;
  }
  .hero .plate {
    aspect-ratio: 21 / 9;
  }
  @media (max-width: 900px) {
    .hero .plate {
      aspect-ratio: 16 / 10;
    }
  }
  figcaption {
    font-size: var(--text-small);
    color: var(--muted);
  }
  figcaption .label {
    color: var(--ink);
  }
</style>
