---
interface Props {
  highlights: { value: string; label: string }[];
}

const { highlights } = Astro.props;
---

<ul class="stats">
  {
    highlights.map(({ value, label }) => (
      <li class="stat">
        <span class="value">{value}</span>
        <span class="label caption">{label}</span>
      </li>
    ))
  }
</ul>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 48px;
    padding: 0;
    list-style: none;
    border-top: var(--rule);
    border-bottom: var(--rule);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border-left: var(--rule-hair);
  }
  .stat:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .value {
    font-size: 44px;
    line-height: 1;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .caption {
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .value {
      font-size: 36px;
    }
  }
  @media (max-width: 640px) {
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }
    .stat,
    .stat:first-child {
      padding: 16px 0;
      border-left: 0;
      border-top: var(--rule-hair);
    }
    .stat:first-child {
      border-top: 0;
    }
    .value {
      font-size: 44px;
    }
  }
</style>
