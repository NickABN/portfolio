---
import BaseLayout from '../../shared/layouts/BaseLayout.astro';
import Footer from '../../shared/ui/Footer.astro';
import Masthead from '../../features/hero/components/Masthead.astro';
import ProjectArticle from '../../features/projects/components/ProjectArticle.astro';
import { getProjects, type ProjectItem } from '../../features/projects/data/getProjects';

export async function getStaticPaths() {
  const projects = await getProjects('en');
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project, projects } }));
}

interface Props {
  project: ProjectItem;
  projects: ProjectItem[];
}

const { project, projects } = Astro.props;
---

<BaseLayout locale="en" title={project.title}>
  <div class="page">
    <Masthead locale="en" variant="compact" />
    <main id="main">
      <ProjectArticle locale="en" project={project} projects={projects} />
    </main>
    <Footer locale="en" />
  </div>
</BaseLayout>
