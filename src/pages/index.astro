---
import BaseLayout from '../shared/layouts/BaseLayout.astro';
import Masthead from '../features/hero/components/Masthead.astro';
import FrontPage from '../features/hero/components/FrontPage.astro';
import SelectedWork from '../features/projects/components/SelectedWork.astro';
import ProjectIndex from '../features/projects/components/ProjectIndex.astro';
import { getProjects } from '../features/projects/data/getProjects';
import { selectArchive, selectFeatured } from '../features/projects/domain/project';

const projects = await getProjects('en');
---

<BaseLayout locale="en">
  <div class="page">
    <Masthead locale="en" />
    <main id="main">
      <FrontPage locale="en" />
      <SelectedWork locale="en" projects={selectFeatured(projects)} />
      <ProjectIndex locale="en" projects={selectArchive(projects)} />
    </main>
  </div>
</BaseLayout>
