---
import BaseLayout from '../../../shared/layouts/BaseLayout.astro';
import ThemeToggle from '../../../shared/ui/ThemeToggle.astro';
import ProjectArticle from '../../../features/projects/components/ProjectArticle.astro';
import { getProjects, type ProjectItem } from '../../../features/projects/data/getProjects';

export async function getStaticPaths() {
  const projects = await getProjects('es');
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<BaseLayout locale="es" title={project.title}>
  <main id="main" class="page">
    <ThemeToggle locale="es" />
    <ProjectArticle locale="es" project={project} />
  </main>
</BaseLayout>
