---
import '../styles/global.css';
import Motion from '../../features/motion/components/Motion.astro';
import ContactRail from '../../features/contact/components/ContactRail.astro';
import type { Locale } from '../i18n/locales';
import { useUi } from '../i18n/ui';
import { site } from '../config/site';
import { buildSeo } from '../seo/meta';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  /** Keeps the page out of search results and skips canonical/hreflang (e.g. the 404 page). */
  noindex?: boolean;
}

const { locale = 'en' } = Astro.props;
const strings = useUi(locale);
const { title = strings.siteTitle, description = strings.siteDescription, noindex = false } = Astro.props;
const seo = buildSeo({
  siteUrl: site.url,
  path: Astro.url.pathname,
  locale,
  title,
  description,
});
const favicon = `${import.meta.env.BASE_URL}favicon.svg`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <meta name="theme-color" content="#eaeaea" />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={seo.canonical} />
          {seo.alternates.map(({ hreflang, href }) => (
            <link rel="alternate" hreflang={hreflang} href={href} />
          ))}
          <meta property="og:url" content={seo.ogUrl} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={seo.ogLocale} />
    {seo.ogLocaleAlternates.map((value) => <meta property="og:locale:alternate" content={value} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Archivo+Narrow:wght@400;500;600&family=IBM+Plex+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Light is the default; apply a saved dark choice before first paint to avoid a flash.
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#07393c');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link label" href="#main">{strings.skipToContent}</a>
    <div class="progress" aria-hidden="true"></div>
    <slot />
    <ContactRail locale={locale} />
    <Motion />
  </body>
</html>
