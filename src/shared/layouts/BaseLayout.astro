---
import '../styles/global.css';
import type { Locale } from '../i18n/locales';
import { useUi } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const strings = useUi(locale);
const { title = strings.siteTitle, description = strings.siteDescription } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Archivo+Narrow:wght@400;500;600&family=IBM+Plex+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link label" href="#main">{strings.skipToContent}</a>
    <slot />
  </body>
</html>
