---
import { site } from '../config/site';
import type { Locale } from '../i18n/locales';
import { useUi } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = useUi(locale);
---

<footer class="footer label">
  <span>© {site.copyrightYear} {site.name}</span>
  <span>{strings.setIn}</span>
  <span>{strings.printed}</span>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0 var(--space-4);
    border-top: var(--rule-double);
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .footer {
      flex-direction: column;
      gap: 6px;
      /* Right padding keeps the text clear of the floating contact buttons. */
      padding: 12px 52px 40px 0;
    }
  }
</style>
