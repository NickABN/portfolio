---
import type { Locale } from '../i18n/locales';
import { useUi } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const strings = useUi(locale);
---

<div class="seg" role="group" aria-label={strings.themeLabel}>
  <button type="button" data-theme-choice="light" aria-pressed="true">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
      ><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
      ></path></svg
    ><span class="seg-label">{strings.themeLight}</span>
  </button>
  <button type="button" data-theme-choice="dark" aria-pressed="false">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      ><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg
    ><span class="seg-label">{strings.themeDark}</span>
  </button>
</div>

<script>
  import { bindThemeToggles, type ThemeToggleButton } from '../theme/bindThemeToggles';

  let storage: Storage | null = null;
  try {
    storage = localStorage;
  } catch {
    // Storage blocked: the choice applies for this visit only.
  }

  bindThemeToggles({
    root: document.documentElement,
    buttons: document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]') as Iterable<ThemeToggleButton>,
    storage,
    onThemeChange: (theme) => {
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', theme === 'dark' ? '#07393c' : '#eaeaea');
    },
  });
</script>
