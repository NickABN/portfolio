---
import type { Locale } from '../i18n/locales';
import { useUi } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const strings = useUi(locale);
---

<button
  type="button"
  class="theme-toggle label"
  data-theme-toggle
  data-label-to-dark={strings.themeToggleToDark}
  data-label-to-light={strings.themeToggleToLight}
  aria-label={strings.themeToggleToDark}
>
  <span aria-hidden="true">◐</span>
</button>

<style>
  .theme-toggle {
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0 6px;
    background: none;
    border: 0;
    border-radius: 0;
    cursor: pointer;
  }
</style>

<script>
  import { nextTheme, resolveTheme, toggleLabel, type Theme } from '../theme/theme';

  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const colorScheme = window.matchMedia('(prefers-color-scheme: dark)');

  function currentTheme(): Theme {
    return resolveTheme(root.getAttribute('data-theme'), colorScheme.matches);
  }

  function syncLabels(): void {
    const theme = currentTheme();
    toggles.forEach((button) => {
      const { labelToDark, labelToLight } = button.dataset;
      if (!labelToDark || !labelToLight) return;
      button.setAttribute('aria-label', toggleLabel(theme, { toDark: labelToDark, toLight: labelToLight }));
    });
  }

  toggles.forEach((button) => {
    button.addEventListener('click', () => {
      const next = nextTheme(currentTheme());
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage unavailable: the choice applies for this visit only.
      }
      syncLabels();
    });
  });

  // Without an explicit choice the theme follows the system, so keep labels in step.
  colorScheme.addEventListener('change', syncLabels);

  syncLabels();
</script>
