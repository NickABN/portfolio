---
import type { Locale } from '../i18n/locales';
import { useUi } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const strings = useUi(locale);
---

<button
  type="button"
  class="theme-toggle label"
  data-theme-toggle
  data-label-to-dark={strings.themeToggleToDark}
  data-label-to-light={strings.themeToggleToLight}
  aria-label={strings.themeToggleToDark}
>
  <span aria-hidden="true">◐</span>
</button>

<style>
  .theme-toggle {
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0 6px;
    background: none;
    border: 0;
    border-radius: 0;
    cursor: pointer;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;

  function isDark(): boolean {
    const explicit = root.getAttribute('data-theme');
    if (explicit) return explicit === 'dark';
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function syncLabel(): void {
    if (!button) return;
    const next = isDark() ? button.dataset.labelToLight : button.dataset.labelToDark;
    if (next) button.setAttribute('aria-label', next);
  }

  button?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage unavailable: the choice applies for this visit only.
    }
    syncLabel();
  });

  syncLabel();
</script>
