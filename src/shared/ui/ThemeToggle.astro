---
import type { Locale } from '../i18n/locales';
import { useUi } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const strings = useUi(locale);
---

<button
  type="button"
  class="theme-toggle label"
  data-theme-toggle
  data-label-to-dark={strings.themeToggleToDark}
  data-label-to-light={strings.themeToggleToLight}
  aria-label={strings.themeToggleToDark}
>
  <span aria-hidden="true">◐</span>
</button>

<style>
  .theme-toggle {
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0 6px;
    background: none;
    border: 0;
    border-radius: 0;
    cursor: pointer;
  }
</style>

<script>
  import { bindThemeToggles, type ThemeToggleButton } from '../theme/bindThemeToggles';

  let storage: Storage | null = null;
  try {
    storage = localStorage;
  } catch {
    // Storage blocked: the choice applies for this visit only.
  }

  bindThemeToggles({
    root: document.documentElement,
    buttons: document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]') as Iterable<ThemeToggleButton>,
    storage,
    colorScheme: window.matchMedia('(prefers-color-scheme: dark)'),
  });
</script>
