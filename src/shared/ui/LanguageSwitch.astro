---
import { locales, type Locale } from '../i18n/locales';
import { useUi } from '../i18n/ui';
import { getAlternatePaths } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** Path the switch localizes (the 404 page passes '/'). */
  switchPath: string;
}

const { locale, switchPath } = Astro.props;
const strings = useUi(locale);
const alternates = getAlternatePaths(switchPath);
---

<div class="seg" role="group" aria-label={strings.langLabel}>
  {
    locales.map((code) => (
      <a href={alternates[code]} hreflang={code} lang={code} aria-current={code === locale ? 'page' : undefined}>
        {code.toUpperCase()}
      </a>
    ))
  }
</div>
