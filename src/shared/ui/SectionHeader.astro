---
interface Props {
  title: string;
  section: string;
  level?: 'major' | 'minor';
}

const { title, section, level = 'major' } = Astro.props;
---

<div class:list={['section-header', level]}>
  <h2>{title}</h2>
  <span class="label">{section}</span>
</div>

<style>
  .section-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .major {
    padding-bottom: 12px;
    border-bottom: var(--rule-double);
    margin-bottom: var(--space-4);
  }
  .minor {
    margin-bottom: var(--space-3);
  }
  h2 {
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .major h2 {
    font-size: var(--text-h2);
  }
  .minor h2 {
    font-size: 32px;
  }
  .label {
    color: var(--muted);
  }
</style>
